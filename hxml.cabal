cabal-version: 2.2

name:           hxml
version:        0.4.6
synopsis:       Indentation-style writing of HTML/XML.
category:       Web
author:         Galen Huntington <galen.huntington@gmail.com>
maintainer:     Galen Huntington <galen.huntington@gmail.com>
license:        MIT
build-type:     Simple

common shared
  hs-source-dirs: .
  build-depends:
    base >=4.9 && <5,
    bytestring >=0.10 && <0.13,
    containers >=0.6 && <0.9,
    megaparsec >=7 && <10,
    mtl >=2.2 && <2.4,
    transformers >=0.5 && <0.7,
  default-language: Haskell2010

library
  import: shared
  exposed-modules:
    Text.Hxml

executable hxml
  import: shared
  main-is: main.hs
  other-modules:
    Text.Hxml
  default-language: Haskell2010

